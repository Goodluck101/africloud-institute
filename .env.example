# Copy this file to .env and replace the placeholders.
# Never commit .env — it is listed in .gitignore.

SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=1
PORT=5000

# Gmail inbox for applications, contact, and corporate forms.
# Locally the app uses Gmail SMTP. Render's free plan blocks SMTP ports,
# so production delivers over HTTPS instead. SMTP_PASSWORD is still
# required for local sending.
INBOX_EMAIL=africloudinstitute@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=africloudinstitute@gmail.com
SMTP_FROM=africloudinstitute@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
